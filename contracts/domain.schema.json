{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "养老机器人共享结算台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ELIGIBILITY_ASSESSED",
        "DEVICE_DELIVERED",
        "USAGE_RECORDED",
        "DEVICE_REPLACED",
        "STATEMENT_SETTLED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "care_recipient",
        "robot_device",
        "rental_agreement",
        "funding_statement"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
